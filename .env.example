# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard -> Connection Details)
DATABASE_URL=

# Resend API key, for invite emails and one-time login codes
RESEND_API_KEY=

# Long random string used to sign session cookies
SESSION_SECRET=

# Base URL used to build links in emails (invite links). Defaults to http://localhost:3000 if unset.
APP_URL=

# First Admin, seeded directly via `npm run seed:admin` (bypasses the invite flow)
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# Optional. Force the DB driver: `pg` (node-postgres, for a local Docker Postgres) or `neon`
# (the serverless HTTP driver). Auto-detected from DATABASE_URL when unset -- Neon for a
# *.neon.tech URL, node-postgres otherwise.
DB_DRIVER=

# Set to 1 only for the Playwright e2e suite. Makes the app append each login code to
# e2e/.artifacts/login-codes.log so the test can complete the real one-time-code UI. Never set
# this in a real deployment.
E2E_TEST_MODE=
